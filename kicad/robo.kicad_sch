			)
			(justify left bottom)
		)
		(uuid "e21c84d4-91d3-48ad-b284-786741b02ccd")
	)
	(text "RC_5V budget: <= 800 mA (BEC).\nLoad: ~20 mA pull-ups + sensors."
		(exclude_from_sim no)
		(at 62.23 113.03 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "f2de7e5d-e19d-4e62-b25e-754e81c7ca60")
	)
	(text "Battery voltage (10-14.6 V) for sensors that need it (E6B2-CWZ6C: 5-24 V, 80 mA)\nand the E-stop / limit-switch loops (4.7k pull-ups). From V_MOTOR, so the return stays on\nthe RoboClaw ground. F4 250 mA PTC, D28 SMAJ20A, C89 10 uF. Encoder pull-ups: RC_5V."
		(exclude_from_sim no)
		(at 208.28 184.15 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f4545f8c-c492-4a45-830b-4766ba7df511")
	)
