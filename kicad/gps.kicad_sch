	(text "GPS"
		(exclude_from_sim no)
		(at 26.162 21.844 0)
		(effects
			(font
				(size 5.08 5.08)
			)
		)
		(uuid "5970efb3-8617-44d0-916a-8d283eda80b1")
	)
	(text "1PPS from FEI FE-5680A rubidium clock, 3-5V logic pulse.\nU18 Schmitt buffer (5V-tolerant input, VT+ <= 2.0V at 3V) shifts\nit to the 3.3V V_IO level; EXTINT abs max is V_IO+0.3V (3.6V).\nR116 holds the input low when nothing is connected.\nEdges on EXTINT are timestamped in UBX-TIM-TM2 (time mark)."
		(exclude_from_sim no)
		(at 201.93 105.41 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "7081c02f-1dcb-41cd-924d-d8c96b790b6a")
	)
	(text "L2 supply-bead DCR must be < 0.2 Ω (u-blox MAX-M10S IM §3.1.1: series\nresistance on VCC causes ripple under dynamic current). BLM18KG121TN1D:\n0.030 Ω max (0.040 Ω after test). Do not substitute a higher-DCR bead."
		(exclude_from_sim no)
		(at 57.15 153.67 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "85cf1627-8d88-453c-bf78-a72c66a0999e")
	)
	(text "D4 (0.25pF) is the antenna ESD clamp - keep it\nright at CN1. Not lightning protection: an outdoor\nrun still needs a coaxial arrestor at the bulkhead."
		(exclude_from_sim no)
		(at 156.21 136.398 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "8adf3eaa-88ef-4f92-9d55-19d02543a5df")
	)
	(text "GPS is input using a MAX-M10S-00B.\nNMEA sentences are used to get the UTC datetime and\nthe 1PPS is used to correct the MCU clock every second.\nSee https://www.mouser.com/pdfDocs/MAX-M10S_IntegrationManual_UBX-20053088.pdf"
		(exclude_from_sim no)
		(at 43.942 34.798 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "c23a9c0b-5bb6-44fa-bb55-52eb6e250320")
	)
	(text "SMA Female"
		(exclude_from_sim no)
		(at 181.102 125.476 0)
