	(text "USB-C Port for CM4 Flashing (rpiboot)"
		(exclude_from_sim no)
		(at 26.924 29.21 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "68c7c52e-ceed-4cbc-992f-7871bf81c0b6")
	)
	(text "U17 is open-drain, powered from 3V3_CM4. With the CM4 off, Y is\nhigh-Z and R60 is unpowered, so U2 Sel and CM4 USB_OTG_ID are never\ndriven (CM4 datasheet 5.1). 74LVC Ioff: A tolerates VBUS_DET at VCC = 0."
		(exclude_from_sim no)
		(at 115.824 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "726ca346-bfd8-4a7e-972d-84d1abe96f66")
	)
	(text "USB_OTG_ID: high = CM4 device mode (rpiboot), \nlow/GND = CM4 host. Needs otg_mode=1 in config.txt.\nUSBC1 VBUS: 5.0 V nom (4.75 V min / 5.5 V max).\nNo USB-PD controller; CC has 5.1 kΩ Rd only.\nVBUS detect: R59/R61 (2.75 V max) -> U17 open-drain -> USB_OTG_ID.\nVBUS current: 1.25 mA continuous / 1.25 mA peak.\nVBUS survives 6.0 V DC (D24 SMF6.0A stand-off), surges\nclamped to 10.3 V; -0.7 V (D24 forward). U17 A sees half via R59/R61."
		(exclude_from_sim no)
		(at 26.67 81.788 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "cda4c191-7b8e-42e4-b048-76bd50fd5e9d")
	)
	(text "VBUS detect buffer"
		(exclude_from_sim no)
		(at 115.824 35.56 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "e73bd37e-843b-406f-89c4-7b15bd57ea28")
	)
